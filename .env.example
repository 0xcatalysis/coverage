# ── Network & tooling ─────────────────────────────────────────
PRIVATE_KEY=your_private_key_here
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_sepolia_alchemy_api_key
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_mainnet_alchemy_api_key
ANVIL_RPC_URL=http://127.0.0.1:8545
ETHERSCAN_API_KEY=your_etherscan_api_key

# ── Catalysis Core addresses (required for Deploy.s.sol) ──────
CHAINLINK_PRICE_FEED=
SLASHING_MANAGER=
STAKE_MANAGER=
REWARDS_MANAGER=
SSP_ROUTER=

# ── Deployment role overrides (all default to deployer/admin) ─
ADMIN=
PLATFORM_TREASURY=
COVER_POOL_FACTORY_CREATOR=
SWAP_MANAGER=
PLATFORM_FEE_BPS=                   # defaults to 500 (5%)

# ── Deployed Coverage proxies ─────────────────────────────────
# Fill these in after Deploy.s.sol (run ShowSepolia.s.sol to read them)
COVER_POOL_FACTORY=
POLICY_MANAGER=
CLAIM_MANAGER=
PREMIUM_MANAGER=
SPEC_REGISTRY=
SWAPPER=

# ── Upgrade script proxies (Upgrade*.s.sol) ───────────────────
COVER_POOL_FACTORY_PROXY=
CLAIM_MANAGER_PROXY=
POLICY_MANAGER_PROXY=
PREMIUM_MANAGER_PROXY=
SWAPPER_PROXY=
SPEC_REGISTRY_PROXY=

# ── Implementation addresses (manual re-pointing only) ────────
COVER_POOL_IMPL=
COVER_POOL_FACTORY_IMPL=
SWAPPER_IMPL=
PREMIUM_MANAGER_IMPL=
CLAIM_MANAGER_IMPL=
POLICY_MANAGER_IMPL=
SPEC_REGISTRY_IMPL=

# ── CreateCoverPool.s.sol ─────────────────────────────────────
CURATOR_PRIVATE_KEY=
QUOTE_SIGNER=
POOL_FEE_BPS=                        # e.g. 1000 = 10%, max 2000

# ── RequestCoverage.s.sol ─────────────────────────────────────
BUYER_PRIVATE_KEY=
COVER_POOL=                          # output of CreateCoverPool
BENEFICIARY=
CLAIMER=
PAYOUT_TOKEN=                        # must be whitelisted on PolicyManager
DURATION=                            # seconds, e.g. 2592000 = 30 days

# ── BindPolicy.s.sol ──────────────────────────────────────────
QUOTE_SIGNER_PRIVATE_KEY=
POLICY_ID=                           # output of RequestCoverage
SPEC_ADDRESS=                        # must be approved in SpecRegistry
BIND_POLICY_HOOK=                    # CoveredVaultWrapper proxy address
VAULTS=                              # comma-separated, e.g. "0x123...,0x456..."
COVERAGE_LIMIT=
SPEC_ID=                             # bytes32 hex
TERMS_HASH=                          # bytes32 hex
EXPIRATION_TIME=                     # unix timestamp, must be > current block

# ── DistributePremium.s.sol ───────────────────────────────────
COVERED_VAULT=

# ── FileClaim.s.sol ───────────────────────────────────────────
CLAIMER_PRIVATE_KEY=
REQUESTED_AMOUNT=
EVIDENCE_HASH=                       # bytes32 hex
ADDITIONAL_DATA=                     # optional hex data for Spec (default: 0x)

# ── PrepareEigenLayer.s.sol ───────────────────────────────────
EIGEN_ALLOCATION_MANAGER=
EIGEN_ADAPTER_ADDRESS=
EIGEN_STRATEGY=
COMMITTEE_ID=
NEW_MAGNITUDE=                       # uint64, max 1e18; default 5e17 (50%)

# ── DeployCoveredVaultWrapper.s.sol ───────────────────────────
MORPHO_VAULT=
MAX_COVERABLE_LOSS_BPS=              # 1–10000, e.g. 1000 = 10%
DEDUCTIBLE_BPS=                      # must be < MAX_COVERABLE_LOSS_BPS
PREMIUM_RECIPIENT=
VAULT_NAME=
VAULT_SYMBOL=
CATALYSIS_OWNER=                     # must call acceptOwnership() after deploy

# ── WireCoreContracts.s.sol ────────────────────────────────────
# Uses: PRIVATE_KEY, STAKE_MANAGER, SLASHING_MANAGER, REWARDS_MANAGER,
#       POLICY_MANAGER, CLAIM_MANAGER, PREMIUM_MANAGER,
#       COVER_POOL_FACTORY, PAYOUT_TOKEN

# ── ApproveSpec.s.sol ─────────────────────────────────────────
# Uses: PRIVATE_KEY, SPEC_REGISTRY, SPEC_ADDRESS

# ── SetPremiumRate.s.sol ───────────────────────────────────────
# Uses: PRIVATE_KEY, COVERED_VAULT
PREMIUM_RATE=                        # wei/second (WAD-scaled); max 15854895991 (~50%/yr)

# ── ResetPolicyBinding.s.sol ──────────────────────────────────
# Uses: PRIVATE_KEY, COVERED_VAULT, POLICY_MANAGER

# ── UpgradeCoveredVaultWrapper.s.sol ──────────────────────────
# Uses: PRIVATE_KEY, COVERED_VAULT
NEW_IMPLEMENTATION=                  # address of the new CoveredVaultWrapper implementation

# ── DeployControllableVault.s.sol ─────────────────────────────
# Uses: PRIVATE_KEY
ASSET_ADDRESS=                       # ERC-20 underlying (e.g. WETH); must equal PAYOUT_TOKEN

# ── DeployUniswapV3Adapter.s.sol ──────────────────────────────
# Uses: PRIVATE_KEY, SWAPPER
SWAP_ROUTER=                         # Uniswap V3 SwapRouter02 address
QUOTER_V2=                           # Uniswap V3 QuoterV2 address
TOKEN_IN=                            # collateral token address
TOKEN_OUT=                           # payout token address
POOL_FEE=                            # Uniswap V3 pool fee tier (e.g. 500 = 0.05%)
