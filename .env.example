# =============================================================
# Coverage Deployment — Environment Variables
#
# Copy this file to .env and fill in all values:
#   cp coverage/.env.example coverage/.env
#   (edit coverage/.env with your addresses and config)
#
# Phase 2 onward sources this file: cd coverage && source .env
# =============================================================

# ── Network & Tooling ─────────────────────────────────────────
RPC_URL=
ETHERSCAN_API_KEY=

# ── Keystore & Signer ─────────────────────────────────────────
# Deployer keystore — encrypted key used to sign all transactions
# Create with: cast wallet new ./deployer deployer
KEYSTORE=./deployer/deployer

# Deployer address — plaintext public address corresponding to KEYSTORE
# Get with: cast wallet address --keystore ./deployer/deployer
DEPLOYER_ADDRESS=

# Quote signer address — EIP-712 quote signer for BindPolicy (Phase 7d)
# Can equal DEPLOYER_ADDRESS on testnet. If separate on mainnet, create a second keystore.
QUOTE_SIGNER_ADDRESS=

# ── Ownership ─────────────────────────────────────────────────
# Core admin — receives DEFAULT_ADMIN_ROLE on all coverage contracts (same as in core/.env)
ADMIN=

# CoverPool curator — set as owner at CoverPool creation (Phase 5); immutable post-creation
COVER_POOL_OWNER=

# CoveredVaultWrapper owner — receives Ownable2Step ownership (Phase 6); must call acceptOwnership()
WRAPPER_OWNER=

# ── Deployment role overrides (all default to ADMIN if not set) ─
PLATFORM_TREASURY=
COVER_POOL_FACTORY_CREATOR=
CLAIM_OPERATOR=
SWAP_MANAGER=
PLATFORM_FEE_BPS=                   # defaults to 500 (5%)

# ── Catalysis Core contract inputs ────────────────────────────
# Copy these from core/.env after Phase 1 deployment
STAKE_MANAGER=
SLASHING_MANAGER=
REWARDS_MANAGER=
SSP_ROUTER=
CHAINLINK_PRICE_FEED=

# ── Token addresses ───────────────────────────────────────────
COLLATERAL_TOKEN=                    # EigenLayer strategy underlying (e.g. wstETH)
PAYOUT_TOKEN=                        # Vault asset and claim settlement token (e.g. WETH)

# ── Deployed Coverage proxies (fill in after Phase 2) ─────────
COVER_POOL_FACTORY=
POLICY_MANAGER=
CLAIM_MANAGER=
PREMIUM_MANAGER=
SPEC_REGISTRY=
SWAPPER=

# ── Phase 3b — UniswapV3Adapter ───────────────────────────────
SWAP_ROUTER=                         # Uniswap V3 SwapRouter02
                                     # Sepolia: 0x3bFA4769FB09eefC5a80d6E87c3B9C650f7Ae48E
                                     # Mainnet: 0x68b3465833fb72A70ecDF485E0e4C7bD8665Fc45
QUOTER_V2=                           # Uniswap V3 QuoterV2
                                     # Sepolia: 0xEd1f6473345F45b75833fd55D16003ae0A5ad44
                                     # Mainnet: 0x61fFE014bA17989E743c5F6cB21bF9697530B21e
TOKEN_IN=                            # Collateral token for swap (copy COLLATERAL_TOKEN)
TOKEN_OUT=                           # Payout token for swap (copy PAYOUT_TOKEN)
POOL_FEE=500                         # Uniswap V3 pool fee tier: 500=0.05%, 3000=0.3%, 10000=1%

# UniswapV3Adapter deployed address (fill in after Phase 3b)
UNISWAP_V3_ADAPTER=

# ── Phase 4 — ControllableVault (testnet) ─────────────────────
ASSET_ADDRESS=                       # Vault underlying asset; must equal PAYOUT_TOKEN
VAULT_ADMIN=                         # Vault admin; on testnet: DEPLOYER_ADDRESS; on mainnet: ADMIN multisig

# Morpho vault address (fill in after Phase 4; testnet: ControllableVault; mainnet: existing Morpho vault)
MORPHO_VAULT=

# ── Phase 5 — CoverPool ───────────────────────────────────────
# CoverPool curator — the script reads CURATOR_ADDRESS; set to COVER_POOL_OWNER value
CURATOR_ADDRESS=                     # Must match COVER_POOL_OWNER; immutable after creation
QUOTE_SIGNER=                        # Address allowed to sign coverage quotes (set to QUOTE_SIGNER_ADDRESS)
POOL_FEE_BPS=500                     # CoverPool fee in bps charged to buyers (e.g. 500=5%; max 2000)

# CoverPool deployed address (fill in after Phase 5)
COVER_POOL=

# ── Phase 6 — CoveredVaultWrapper ─────────────────────────────
MAX_COVERABLE_LOSS_BPS=5000          # Max fraction of NAV losable in a single claim (1–10000)
DEDUCTIBLE_BPS=0                     # Deductible per claim; must be < MAX_COVERABLE_LOSS_BPS
PREMIUM_RECIPIENT=                   # Address receiving premium payments (set to PREMIUM_MANAGER)
VAULT_NAME=                          # ERC-4626 token name (e.g. "Covered WETH Vault")
VAULT_SYMBOL=                        # ERC-4626 token symbol (e.g. "cvWETH")
CATALYSIS_OWNER=                     # Wrapper owner; set to WRAPPER_OWNER; must call acceptOwnership()

# CoveredVaultWrapper deployed address (fill in after Phase 6)
COVERED_VAULT_WRAPPER=

# COVERED_VAULT is used by SetPremiumRate.s.sol, ResetPolicyBinding.s.sol, UpgradeCoveredVaultWrapper.s.sol
# Set to the same address as COVERED_VAULT_WRAPPER after Phase 6
COVERED_VAULT=

# ── Phase 7a — Request Coverage ───────────────────────────────
BENEFICIARY=                         # Address entitled to receive claim payouts
DURATION=                            # Coverage duration in seconds (e.g. 2592000 = 30 days)

# POLICY_ID — fill in after Phase 7a (from emitted event)
POLICY_ID=

# ── Phase 7c — Bind Policy ────────────────────────────────────
# SPEC_ADDRESS is also read by ApproveSpec.s.sol (Phase 7b); set to COVERED_VAULT_WRAPPER
SPEC_ADDRESS=                        # CoveredVaultWrapper proxy address (Phase 6 output)
VAULTS=                              # Comma-separated EigenLayer DurationVault addresses
                                     # Get with: cast call $STAKE_MANAGER "getCommitteeVaults(uint96)" $POLICY_ID
COVERAGE_LIMIT=                      # Max payout in payout token raw units (no decimal scaling)
SPEC_ID=                             # bytes32 hex — uniquely identifies the coverage spec
TERMS_HASH=                          # bytes32 hex — commitment to off-chain policy terms document
EXPIRATION_TIME=                     # Unix timestamp; must be in the future when bindPolicy runs
                                     # macOS: $(date -v +1H +%s)   Linux: $(date -d '+1 hour' +%s)

# Pre-generated quote signature — only required when DEPLOYER_ADDRESS != QUOTE_SIGNER_ADDRESS.
# When they are the same, BindPolicy signs inline and this var is ignored.
# To generate: forge script script/testing/SignQuote.s.sol \
#   --rpc-url $RPC_URL --keystore $QUOTE_SIGNER_KEYSTORE --sender $QUOTE_SIGNER_ADDRESS -vvvv
# Copy the printed value here, then run BindPolicy.s.sol with the deployer keystore.
QUOTE_SIGNATURE=                     # 65-byte hex (0x...); leave blank if same signer as deployer

# ── Phase 8 — Set Premium Rate ────────────────────────────────
PREMIUM_RATE=                        # WAD-scaled wei/second; max 15854895991 (~50%/yr)
                                     # Examples: 317097919 ≈ 1%/yr, 158548959 ≈ 0.5%/yr

# ── DistributePremium.s.sol ───────────────────────────────────
# Uses: DEPLOYER_ADDRESS, COVERED_VAULT, PREMIUM_MANAGER, COVER_POOL

# ── FileClaim.s.sol (testing) ─────────────────────────────────
CLAIMER_PRIVATE_KEY=
REQUESTED_AMOUNT=
EVIDENCE_HASH=                       # bytes32 hex
ADDITIONAL_DATA=                     # optional hex data for Spec (default: 0x)

# ── PrepareEigenLayer.s.sol (testing) ─────────────────────────
EIGEN_ALLOCATION_MANAGER=
EIGEN_ADAPTER_ADDRESS=
EIGEN_STRATEGY=
COMMITTEE_ID=
NEW_MAGNITUDE=                       # uint64, max 1e18; default 5e17 (50%)

# ── Upgrade scripts ───────────────────────────────────────────
COVER_POOL_FACTORY_PROXY=
CLAIM_MANAGER_PROXY=
POLICY_MANAGER_PROXY=
PREMIUM_MANAGER_PROXY=
SWAPPER_PROXY=
SPEC_REGISTRY_PROXY=
COVER_POOL_IMPL=
COVER_POOL_FACTORY_IMPL=
SWAPPER_IMPL=
PREMIUM_MANAGER_IMPL=
CLAIM_MANAGER_IMPL=
POLICY_MANAGER_IMPL=
SPEC_REGISTRY_IMPL=
NEW_IMPLEMENTATION=                  # address of new CoveredVaultWrapper implementation (for upgrade)
