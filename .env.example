# Private key for the deployer account
PRIVATE_KEY=your_private_key_here
# RPC URL for Sepolia testnet
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_sepolia_alchemy_api_key
# RPC URL for Ethereum mainnet
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/your_mainnet_alchemy_api_key
# RPC URL for local Anvil (defaults to http://127.0.0.1:8545)
ANVIL_RPC_URL=http://127.0.0.1:8545
# Etherscan API key for contract verification on Sepolia and Ethereum
ETHERSCAN_API_KEY=your_etherscan_api_key

# ChainlinkPriceFeed contract
CHAINLINK_PRICE_FEED=
# SlashingManager contract address from Catalysis Core
SLASHING_MANAGER=
# StakeManager contract address from Catalysis Core
STAKE_MANAGER=
# RewardsManager contract address from Catalysis Core
REWARDS_MANAGER=

# Admin address for DEFAULT_ADMIN_ROLE (defaults to deployer)
ADMIN=
# Platform treasury address (defaults to admin)
PLATFORM_TREASURY=
# CoverPoolFactory CREATOR_ROLE holder (defaults to admin)
COVER_POOL_FACTORY_CREATOR=
# ClaimManager CLAIM_OPERATOR_ROLE holder (defaults to admin)
CLAIM_OPERATOR=
# Swapper SWAP_MANAGER_ROLE holder (defaults to admin)
SWAP_MANAGER=

# Platform fee in basis points (defaults to 500 = 5% if not set)
PLATFORM_FEE_BPS=

# CoverPool implementation address
COVER_POOL_IMPL=
# CoverPoolFactory implementation address
COVER_POOL_FACTORY_IMPL=
# Swapper implementation address
SWAPPER_IMPL=
# Policy implementation address
POLICY_IMPL=
# PremiumReserve implementation address
PREMIUM_RESERVE_IMPL=
# PremiumManager implementation address
PREMIUM_MANAGER_IMPL=
# ClaimManager implementation address
CLAIM_MANAGER_IMPL=
# PolicyManager implementation address
POLICY_MANAGER_IMPL=
# SpecRegistry implementation address
SPEC_REGISTRY_IMPL=
